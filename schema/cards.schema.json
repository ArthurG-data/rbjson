{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArthurG-data/rbjson/schema/cards.schema.json",
  "title": "rbjson card file",
  "description": "data/cards/<set>.json: the cards whose number starts with <set>, each with every printing of it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cards"
  ],
  "properties": {
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "name",
          "printings"
        ],
        "properties": {
          "number": {
            "type": "string",
            "pattern": "^[A-Z]{3}-([0-9]{3}|SP[0-9]+|R[0-9]{2}|T[0-9]{2})$",
            "description": "Set code and collector number without any variant suffix: OGN-119 for OGN-119/298 and OGN-119a/298 alike. SP, R and T number promos, runes and tokens."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "subtitle": {
            "type": "string",
            "minLength": 1,
            "description": "The epithet under a champion's name (Ahri, Inquisitive). One champion has one card per subtitle."
          },
          "type": {
            "enum": [
              "unit",
              "spell",
              "gear",
              "battlefield",
              "legend",
              "rune"
            ],
            "description": "Absent on the few tokens the gallery gives no type."
          },
          "superTypes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "champion",
                "signature",
                "token",
                "basic"
              ]
            }
          },
          "domains": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "fury",
                "calm",
                "mind",
                "body",
                "order",
                "chaos",
                "colorless"
              ]
            }
          },
          "energy": {
            "type": "integer",
            "minimum": 0
          },
          "power": {
            "type": "integer",
            "minimum": 0
          },
          "might": {
            "type": "integer",
            "minimum": 0
          },
          "mightBonus": {
            "type": "integer",
            "minimum": 0
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "printings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/printing"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "printing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "collectorNumber",
        "rarity",
        "image",
        "source",
        "identifiers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{3}-([0-9]{3}|SP[0-9]+|R[0-9]{2}|T[0-9]{2})[a*]?$",
          "description": "The card number as printed, before the slash: OGN-119, OGN-119a, OGN-304*. The suffix tells the variants of one number apart."
        },
        "language": {
          "enum": [
            "en",
            "fr",
            "de",
            "ja",
            "ko"
          ],
          "description": "The printing's language. Absent means en."
        },
        "collectorNumber": {
          "type": "integer",
          "minimum": 0,
          "description": "The number as an integer, as the gallery sorts by it."
        },
        "suffix": {
          "enum": [
            "a",
            "*"
          ],
          "description": "The variant mark printed after the number. a is an alternate art of the same number; * marks a further variant of an overnumbered card."
        },
        "rarity": {
          "enum": [
            "common",
            "uncommon",
            "rare",
            "epic",
            "showcase"
          ]
        },
        "image": {
          "type": "string",
          "format": "uri"
        },
        "artists": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "const": "riot-gallery"
        },
        "identifiers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "galleryId",
            "publicCode"
          ],
          "properties": {
            "galleryId": {
              "type": "string",
              "pattern": "^[a-z]{3}-[a-z0-9-]+$",
              "description": "The gallery entry's id (ogn-119a-298)."
            },
            "publicCode": {
              "type": "string",
              "description": "The code as the gallery prints it (OGN-119a/298)."
            },
            "tcgplayerProductIds": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 1,
              "items": {
                "type": "integer"
              },
              "description": "The TCGplayer products that sell the printing, from TCGCSV category 89 (tools/import_tcgcsv.py)."
            }
          }
        },
        "finishes": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "enum": [
              "nonfoil",
              "foil"
            ]
          },
          "description": "The finishes TCGplayer has priced the printing's product in (Normal is nonfoil, Foil is foil). A finish stays once seen. Absent on a printing TCGplayer has never priced."
        },
        "tcgplayer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "match"
          ],
          "description": "How the TCGplayer product was tied to this printing: by its set and number.",
          "properties": {
            "name": {
              "type": "string"
            },
            "match": {
              "enum": [
                "number"
              ]
            }
          }
        }
      }
    }
  }
}
